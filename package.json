{
  "name": "doctors-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/generate-search-index.ts && tsx scripts/generate-rss.ts && tsx scripts/generate-og-images.ts && tsx scripts/generate-drug-classes.ts",
    "build": "next build && tsx scripts/fix-sitemap-export.ts",
    "start": "next start",
    "lint": "eslint app components lib hooks types utils --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts && tsx scripts/validate-sitemap.ts",
    "fix:p0": "tsx scripts/fix-p0-content.ts",
    "compliance:strip-doctors": "tsx scripts/compliance-strip-doctors.ts",
    "audit:links": "tsx scripts/audit-internal-links.ts",
    "fetch": "tsx scripts/run-pipeline.ts all",
    "build-content": "tsx scripts/run-pipeline.ts all && tsx scripts/validate-content.ts && tsx scripts/generate-search-index.ts",
    "generate:content": "npm run build-content",
    "pipeline": "tsx scripts/run-pipeline.ts",
    "pipeline:medicines": "tsx scripts/run-pipeline.ts medicines",
    "pipeline:diseases": "tsx scripts/run-pipeline.ts diseases",
    "pipeline:symptoms": "tsx scripts/run-pipeline.ts symptoms",
    "pipeline:tests": "tsx scripts/run-pipeline.ts tests",
    "pipeline:first-aid": "tsx scripts/run-pipeline.ts first-aid",
    "pipeline:articles": "tsx scripts/run-pipeline.ts articles",
    "pipeline:calculators": "tsx scripts/run-pipeline.ts calculators",
    "pipeline:all": "tsx scripts/run-pipeline.ts all",
    "pipeline:expand-seeds": "tsx scripts/shared/expand-seeds.ts",
    "pipeline:verify": "tsx scripts/verify-adapter.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.10",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "lucide-react": "^0.525.0",
    "next": "^15.4.1",
    "next-seo": "^6.8.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "axios": "^1.11.0",
    "cheerio": "^1.1.2",
    "eslint": "^9.31.0",
    "eslint-config-next": "^15.4.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "zod": "^4.0.5"
  }
}
